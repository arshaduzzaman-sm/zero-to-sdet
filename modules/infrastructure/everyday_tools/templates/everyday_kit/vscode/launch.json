{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug the tests in this file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Debug the tests that failed last time",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["--lf", "-x", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
