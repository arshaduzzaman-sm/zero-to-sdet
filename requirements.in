# Code and test tools for modules/, scripts/ and the templates.
# Compile with hashes:  uv pip compile --generate-hashes requirements.in -o requirements.txt
# Install:              uv pip sync --require-hashes requirements-docs.txt requirements.txt practice-app/requirements.txt
pytest
httpx2       # the Practice App's own API tests (FastAPI TestClient; the httpx successor Starlette asks for)
ruff
pyphen
coverage     # which lines and branches the tests run (Test design techniques: coverage lesson)
requests     # HTTP calls in the API testing lessons and templates
jsonschema   # checking the shape of API responses (API testing: schema validation)
openpyxl     # reading test data from Excel files (Data-driven testing)
robotframework  # keyword-driven testing (Data-driven testing: Robot Framework lesson)
behave       # BDD with Gherkin feature files, own runner (BDD testing)
pytest-bdd   # BDD with the same feature files, run by pytest (BDD testing)
playwright   # browser automation (BDD for UI, UI automation)
pytest-html  # one-file HTML test report (Reporting and logging)
allure-pytest  # Allure test results for the Allure report (Reporting and logging)
# Release-age caps: these newer releases were under two weeks old on 2026-11-16.
# Remove a cap once that release is two weeks old.
playwright<1.65
gherkin-official<43
cucumber-expressions<20.2
cucumber-tag-expressions<11.1
