# Practice App dependencies (top level). Pinned, hashed lock file: requirements.txt
# Update with (from the repository root):
#   uv pip compile practice-app/requirements.in --generate-hashes --python-version 3.13 -o practice-app/requirements.txt
fastapi          # the API, its checks (Pydantic) and the /docs page
uvicorn          # runs the API
sqlalchemy       # talks to the database
pyjwt            # login tokens (JWT)
argon2-cffi      # stores passwords safely (Argon2 hashes)
psycopg[binary]  # PostgreSQL driver (the main database)
pymysql          # MySQL driver (the reporting copy)
pymongo          # MongoDB driver (reviews)
faker            # fake customers, orders and reviews for the seed data (fixed random seed)
jinja2           # the web pages (HTML templates, safe escaping on by default)
python-multipart # reads the web page forms
fpdf2            # invoice PDFs
pillow           # checks uploaded pictures and saves a clean copy (no hidden metadata)
