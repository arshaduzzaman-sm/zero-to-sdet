# Practice App settings. Copy this file to .env (never commit .env) and change what you like.
# Every value here is fake and works only on your own computer.

# ----- Databases -----
# Without Docker: leave these three out. The app uses SQLite files in practice-app/data/.
# With Docker (docker compose up -d): remove the # in front of these three lines.
# DATABASE_URL=postgresql+psycopg://bookshelf:local_only_password@127.0.0.1:55432/bookshelf
# REPORTING_DATABASE_URL=mysql+pymysql://bookshelf:local_only_password@127.0.0.1:53306/reporting
# MONGODB_URL=mongodb://bookshelf:local_only_password@127.0.0.1:57017/?authSource=admin

# Passwords Docker gives the databases on their first start. If you change one,
# change it in the URLs above too, then run: docker compose down -v && docker compose up -d
# Use only letters, digits and _ in them (they go inside the database addresses).
POSTGRES_PASSWORD=local_only_password
MYSQL_PASSWORD=local_only_password
MYSQL_ROOT_PASSWORD=local_only_root_password
MONGO_PASSWORD=local_only_password

# ----- Email -----
# Without Docker: leave SMTP_HOST out. Emails are printed in the terminal and saved in
# practice-app/data/outbox/. With Docker: remove the # below. Emails then go to Mailpit;
# read them at http://127.0.0.1:58025.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=51025

# How often orders are copied to the reporting database, in seconds (0: only on request).
REPORTING_SYNC_SECONDS=60

# Extra fake customers (with orders and reviews) made by Faker. Same data every time.
FAKE_CUSTOMERS=40

# ----- The app -----

# Signs login tokens and one-time codes. Any long random text. Leave it out to make a
# new one on every start (then everyone has to log in again after a restart).
SECRET_KEY=local_only_secret_key_change_me_to_any_long_random_text

# Where the API listens. Keep 127.0.0.1 so other computers cannot reach it.
HOST=127.0.0.1
PORT=8080

# How long a login token lasts.
TOKEN_MINUTES=30

# Passwords of the seeded users: arshad and maria (customers), admin.
SEED_CUSTOMER_PASSWORD=Test@1234
SEED_ADMIN_PASSWORD=local_only_password

# How long the "timeout" sandbox card (4000 0000 0000 9995) waits, in seconds.
PAYMENT_TIMEOUT_SECONDS=3

# Bugs planted on purpose for the Bug Hunts. off: see the correct behavior.
PRACTICE_APP_BUGS=on

# Lets an admin move the app's clock (POST /api/admin/clock). on or off.
CLOCK_CONTROL=on
